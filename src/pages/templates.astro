}

/* Templates Grid */
.templates-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    width: 100%;
}

.template-card {
    background: #FDFDFD;
    border: 1px solid #EAEDF2;
    border-radius: 10px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.template-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(10, 17, 30, 0.05);
    border-color: #CCD2DD;
    cursor: pointer;
}

.card-image-wrap {
    position: relative;
    height: 240px;
    width: 100%;
    overflow: hidden;
    background: #EAEDF2;
}

.card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.12);
    transition: transform 0.5s ease;
}

.template-card:hover .card-img {
    transform: scale(1.15);
}

.category-badge {
    position: absolute;
    left: 20px;
    bottom: 20px;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(4px);
    color: #FFFFFF;
    font-family: 'Lato', sans-serif;
    font-size: 12px;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: 8px;
