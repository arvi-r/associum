---

<Layout title="Professional Templates | Associum">


    <!-- Header placeholder (loaded dynamically) -->
    

    <main class="templates-main">
        <section class="templates-hero">
            <div class="hero-container" data-reveal="true" style="--reveal-delay: 0.1s">
                <h1 class="hero-title">
                    <span class="title-professional">Professional Templates </span><br/>
                    <span class="title-built-for">Built for Real Work</span>
                </h1>
                <p class="hero-subtitle">Access a growing library of AI-powered templates designed to produce
                    professional reports, analyses, and presentations faster than ever.</p>
            </div>
        </section>

        <section class="browse-section">
            <div class="browse-container">
                <div class="browse-header" data-reveal="true" style="--reveal-delay: 0.1s">
                    <div class="header-text">
                        <h2 class="browse-title">Browse Professional Templates</h2>
                        <p class="browse-subtitle">Choose a category to explore templates designed for your workflow</p>
                    </div>
                    <div class="header-controls" style="position: relative;">
                        <button class="control-btn btn-filters" id="btn-filters-toggle">
                            <svg class="icon-filter" width="18" height="18" viewBox="0 0 24 24" fill="none"
                                stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="4" y1="21" x2="4" y2="14"></line>
                                <line x1="4" y1="10" x2="4" y2="3"></line>
                                <line x1="12" y1="21" x2="12" y2="12"></line>
                                <line x1="12" y1="8" x2="12" y2="3"></line>
                                <line x1="20" y1="21" x2="20" y2="16"></line>
                                <line x1="20" y1="12" x2="20" y2="3"></line>
                                <line x1="1" y1="14" x2="7" y2="14"></line>
                                <line x1="9" y1="8" x2="15" y2="8"></line>
                                <line x1="17" y1="16" x2="23" y2="16"></line>
                            </svg>
                            <span>Filters</span>
                            <span class="filter-count" id="filter-count" style="display: none;"></span>
                        </button>

                        <!-- Filter Popup -->
                        <div class="filter-popup" id="filter-popup">
                            <div class="filter-popup-header">
                                <h3>Filters</h3>
                                <button class="btn-close-filter" id="btn-close-filter" aria-label="Close filters">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0F0F10"
                                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="18" y1="6" x2="6" y2="18"></line>
                                        <line x1="6" y1="6" x2="18" y2="18"></line>
                                    </svg>
                                </button>
                            </div>
                            <div class="filter-popup-body">
                                <div class="filter-group">
                                    <h4>Category</h4>
                                    <div class="filter-options">
                                        <button class="filter-option" data-category="Finance">Finance</button>
                                        <button class="filter-option" data-category="Consulting">Consulting</button>
                                        <button class="filter-option" data-category="Accounting">Accounting</button>
                                        <button class="filter-option" data-category="Compliance">Compliance</button>
                                    </div>
                                </div>
                                <div class="filter-group">
                                    <h4>Format</h4>
                                    <div class="filter-options">
                                        <button class="filter-option format-option" data-format="PDF">PDF</button>
                                        <button class="filter-option format-option" data-format="PPTX">PPTX</button>
                                    </div>
                                </div>
                            </div>
                            <div class="filter-popup-footer">
                                <button class="btn-filter-reset" id="btn-filter-reset">Reset</button>
                                <button class="btn-filter-apply" id="btn-filter-apply">Apply</button>
                            </div>
                        </div>

                        <div class="search-box">
                            <svg class="icon-search" width="18" height="18" viewBox="0 0 24 24" fill="none"
                                stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="11" cy="11" r="8"></circle>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            </svg>
                            <input type="text" placeholder="Search templates..." class="search-input" id="search-input">
                            <button class="btn-clear-search" id="btn-clear-search" aria-label="Clear search">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="18" y1="6" x2="6" y2="18"></line>
                                    <line x1="6" y1="6" x2="18" y2="18"></line>
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="templates-grid">
                    {templates.map((template) => (
                        <div class="template-card" data-category={template.category} data-format={template.formatClass === 'PDF' ? 'PDF' : 'PPTX'} data-reveal="true"
                            style={`--reveal-delay: ${template.delay}`}>
                            <div class="card-image-wrap">
                                <img src={template.image} alt={template.title}
                                    class="card-img">
                                <span class="category-badge">{template.category}</span>
                            </div>
                            <div class="card-info">
                                <h3 class="card-title">{template.title}</h3>
                                <p class="card-desc">{template.desc}</p>
                            </div>
                            <div class="card-footer">
                                <div class="file-type">
                                    {template.formatClass === 'PDF' ? (
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                            <polyline points="14 2 14 8 20 8"></polyline>
                                            <line x1="16" y1="13" x2="8" y2="13"></line>
                                            <line x1="16" y1="17" x2="8" y2="17"></line>
                                            <polyline points="10 9 9 9 8 9"></polyline>
                                        </svg>
                                    ) : (
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <rect x="2" y="2" width="20" height="14" rx="2" ry="2"></rect>
                                            <line x1="12" y1="22" x2="12" y2="16"></line>
                                            <line x1="8" y1="22" x2="16" y2="22"></line>
                                            <line x1="12" y1="10" x2="8" y2="10"></line>
                                            <line x1="12" y1="6" x2="16" y2="6"></line>
                                        </svg>
                                    )}
                                    <span>{template.format}</span>
                                </div>
                                <button class="btn-preview" onclick={`window.location.href='${template.previewUrl}'`}>Preview Template</button>
                            </div>
                        </div>
                    ))}
                </div>
                <div class="pagination-wrapper" data-reveal="true" style="--reveal-delay: 0.2s">
                    <div class="pagination">
                        <button class="page-btn page-nav-btn" id="btn-first" aria-label="First page">
                            <img src="/assets/images/templates/templates/arrow-left-2.svg" alt="First"
                                class="page-arrow">
                        </button>
                        <button class="page-btn page-nav-btn" id="btn-prev" aria-label="Previous page">
                            <img src="/assets/images/templates/templates/arrow-left-1.svg" alt="Previous"
                                class="page-arrow">
                        </button>
                        <div class="page-numbers" id="page-numbers-container"
                            style="display: flex; gap: 12px; align-items: center;">
                            <!-- Page numbers will be rendered dynamically -->
                        </div>
                        <button class="page-btn page-nav-btn" id="btn-next" aria-label="Next page">
                            <img src="/assets/images/templates/templates/arrow-right-1.svg" alt="Next"
                                class="page-arrow">
                        </button>
                        <button class="page-btn page-nav-btn" id="btn-last" aria-label="Last page">
                            <img src="/assets/images/templates/templates/arrow-right-2.svg" alt="Last"
                                class="page-arrow">
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA Section -->
        <section class="cta-section">
            <div class="cta-wrapper">
                <div class="cta-container">
                    <div class="cta-content">
                        <h2 class="cta-title" data-reveal="true" style="--reveal-delay: 0.1s">Ready to deploy Associum
                            across your firm?</h2>
                        <p class="cta-desc" data-reveal="true" style="--reveal-delay: 0.2s">Tell us your team size,
                            deployment requirements, and security constraints. We respond within one business day.</p>
                    </div>
                    <div class="cta-buttons" data-reveal="true" style="--reveal-delay: 0.3s">
                        <button class="btn-full-security">Talk to our Enterprise Team</button>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- Footer placeholder (loaded dynamically) -->
    <footer id="footer-placeholder"></footer>

    <!-- Component Loader Script -->
    
    

</Layout>

<style>
/* Templates Page CSS */

.templates-main {
    background-color: #0A111E;
    width: 100%;
    overflow: hidden;
}

/* Hero Section */
.templates-hero {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    align-self: stretch;
    min-height: 600px;
    position: relative;
    padding: 170px 24px 80px 24px;
    background: url('/assets/images/templates/hero/hero.webp') no-repeat center center / cover;
    z-index: 1;
}

.hero-container {
    max-width: 800px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 24px;
}

.hero-title {
    margin: 0;
    line-height: 119%;
    text-align: center;
}

.title-professional {
    color: #F9FAFB;
    font-family: 'Lato', sans-serif;
    font-size: 48px;
    font-style: normal;
    font-weight: 700;
    line-height: 119%;
}

.title-built-for {
    color: #FFFFFF;
    font-family: 'Lato', sans-serif;
    font-size: 48px;
    font-style: normal;
    font-weight: 700;
    line-height: 119%;
}

.hero-subtitle {
    color: #B7C3D2;
    text-align: center;
    font-family: 'Inter', sans-serif;
    font-size: 18px;
    font-style: normal;
    font-weight: 400;
    line-height: 28px;
    max-width: 672px;
    margin: 0;
}

/* Browse Templates Section */
.browse-section {
    background: linear-gradient(129deg, #F9FAFB 2%, #FFFFFF 100%);
    padding: 80px 100px 100px 100px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    box-sizing: border-box;
    z-index: 2;
    position: relative;
}

.browse-container {
    max-width: 1240px;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 40px;
}

.browse-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    flex-wrap: wrap;
    gap: 24px;
    position: relative;
    z-index: 100;
}

.header-text {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.browse-title {
    color: #0F0F10;
    font-family: 'Inter', sans-serif;
    font-size: 36px;
    font-weight: 700;
    line-height: 140%;
    margin: 0;
}

.browse-subtitle {
    color: #888E9E;
    font-family: 'Inter', sans-serif;
    font-size: 18px;
    font-weight: 400;
    line-height: 140%;
    margin: 0;
}

.header-controls {
    display: flex;
    align-items: center;
    gap: 16px;
    position: relative;
    z-index: 100;
}

.control-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    border: 1px solid #CCD2DD;
    background: #FFFFFF;
    padding: 10px 20px;
    border-radius: 10px;
    cursor: pointer;
    color: #555F75;
    font-family: 'Inter', sans-serif;
    font-size: 18px;
    font-weight: 400;
    transition: all 0.2s ease;
}

.control-btn:hover, .btn-filters.active {
    background: #F8FAF9;
    border-color: #0F8560;
    color: #0F8560;
}

.filter-count {
    display: none;
    align-items: center;
    justify-content: center;
    background: #0F8560;
    color: #FFFFFF;
    font-size: 12px;
    font-weight: 600;
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    border-radius: 10px;
    margin-left: 2px;
}

.filter-count.show {
    display: inline-flex;
}

.search-box {
    display: flex;
    align-items: center;
    gap: 8px;
    border: 1px solid #CCD2DD;
    background: #FFFFFF;
    padding: 10px 16px;
    border-radius: 10px;
    width: 244px;
    color: #555F75;
    box-sizing: border-box;
    transition: all 0.2s ease;
}

.search-box:focus-within {
    border-color: #0F8560;
    box-shadow: 0 0 0 2px rgba(15, 133, 96, 0.1);
}

.search-input {
    border: none;
    outline: none;
    width: 100%;
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    color: #0F0F10;
}

.search-input::placeholder {
    color: #888E9E;
}

.btn-clear-search {
    background: none;
    border: none;
    padding: 2px;
    cursor: pointer;
    color: #888E9E;
    display: none;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: background-color 0.2s ease, color 0.2s ease;
}

.btn-clear-search:hover {
    background-color: #EAEDF2;
    color: #555F75;
}

.btn-clear-search.show {
