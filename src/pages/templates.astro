}

.card-title {
    color: #0F0F10;
    font-family: 'Inter', sans-serif;
    font-size: 22px;
    font-weight: 600;
    line-height: normal;
    margin: 0;
    letter-spacing: -0.44px;
}

.card-desc {
    color: #0F0F10;
    opacity: 0.6;
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
